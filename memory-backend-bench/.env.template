# Required for the shared answer model.
ANTHROPIC_API_KEY=

# Required for the shared judge, and for gbrain embeddings unless your gbrain config uses another provider.
OPENAI_API_KEY=

# Present for gbrain configs that use ZeroEntropy embeddings or reranking.
ZEROENTROPY_API_KEY=

# Optional model labels. Keep these fixed across both backends for an apples-to-apples run.
ANSWER_MODEL=claude-sonnet-4-5
JUDGE_MODEL=gpt-4o-2024-08-06

# Local gbrain checkout. Default is the parent repo when this kit lives under gbrain/.
GBRAIN_REPO=..
GBRAIN_SEARCH_MODE=balanced

# Honcho fixture. Use START_HONCHO=1 with scripts/run_all.sh to clone/start it under /tmp.
HONCHO_BASE_URL=http://localhost:8000
HONCHO_PORT=8000
HONCHO_API_KEY=
HONCHO_FIXTURE_DIR=/tmp/honcho-memory-bench
HONCHO_TIMEOUT_SECONDS=900
HONCHO_SKIP_DREAM=0
HONCHO_CLEANUP_WORKSPACE=0

# Benchmark defaults.
BENCH_DATASETS=longmemeval-s,locomo
BENCH_BACKENDS=gbrain,honcho
BENCH_LIMIT=
BENCH_SEED=20260615
CONTEXT_TOKEN_BUDGET=4096
ANSWER_MAX_TOKENS=512
TOP_K=8
